#pragma kernel TraceVertices
#pragma kernel BuildTriangles
#pragma kernel ClearEdgeFlags
#pragma kernel MarkBoundaryEdges
#pragma kernel TraceEdgeMidpoints
#pragma kernel BuildProjectedTriangles
#pragma kernel BuildOutputArgs
#pragma require inlineraytracing

#include "UnityRayQuery.cginc"

RaytracingAccelerationStructure _AccelerationStructure;

struct RayHit
{
    float3 position;
    float distance;
    uint instanceId;
    uint primitiveIndex;
    uint valid;
    uint padding;
    float3 receiverNormal;
    float normalPadding;
};

struct TriangleResult
{
    float intensity;
    float incidentArea;
    float receiverArea;
    uint valid;
    float3 renderNormal;
    uint receiverBoundary;
};

struct SourceVertex
{
    float3 position;
    float3 normal;
};

struct SourceEdge
{
    uint vertex0;
    uint vertex1;
};

struct ProjectedResult
{
    float intensity;
    uint receiverBoundary;
    uint valid;
    uint padding;
};

StructuredBuffer<SourceVertex> _SourceVertices;
StructuredBuffer<uint> _SourceIndices;
RWStructuredBuffer<RayHit> _Hits;
RWStructuredBuffer<TriangleResult> _TriangleResults;
StructuredBuffer<SourceEdge> _SourceEdges;
StructuredBuffer<uint> _TriangleEdges;
RWStructuredBuffer<uint> _EdgeFlags;
RWStructuredBuffer<RayHit> _EdgeHits;
RWStructuredBuffer<uint> _ProjectedIndices;
RWStructuredBuffer<ProjectedResult> _ProjectedResults;
RWStructuredBuffer<uint> _OutputCounter;
RWStructuredBuffer<uint> _OutputArgs;
StructuredBuffer<uint> _ReceiverPrimitiveOffsets;
StructuredBuffer<float3> _ReceiverPrimitiveNormals;

float4x4 _SourceLocalToWorld;
float4x4 _SourceNormalToWorld;
uint _VertexCount;
uint _TriangleCount;
float3 _IncidentDirection;
float _Eta;
float _RayTMin;
float _RayTMax;
float _MinReceiverArea;
float _ReceiverBoundaryNormalCos;
uint _EdgeCount;
uint _MaxOutputTriangles;
uint _EnableSubdivision;

uint GetBoundaryReason(RayHit a, RayHit b)
{
    if (a.valid == 0 || b.valid == 0)
        return 0;
    if (a.instanceId != b.instanceId)
        return 2;
    if (a.primitiveIndex == b.primitiveIndex)
        return 0;
    return abs(dot(a.receiverNormal, b.receiverNormal)) < _ReceiverBoundaryNormalCos ? 1 : 0;
}

float3 GetSourceVertexWorld(uint index)
{
    return mul(_SourceLocalToWorld, float4(_SourceVertices[index].position, 1)).xyz;
}

float3 GetSourceNormalWorld(uint index)
{
    return normalize(mul((float3x3)_SourceNormalToWorld, _SourceVertices[index].normal));
}

RayHit TraceSourcePoint(float3 origin, float3 sourceNormal)
{
    RayHit result = (RayHit)0;
    const float3 direction = refract(normalize(_IncidentDirection), sourceNormal, _Eta);
    if (dot(direction, direction) == 0)
        return result;

    RayDesc ray;
    ray.Origin = origin;
    ray.Direction = direction;
    ray.TMin = _RayTMin;
    ray.TMax = _RayTMax;

    const uint rayFlags = RAY_FLAG_FORCE_OPAQUE;
    UnityRayQuery<rayFlags> rayQuery;
    rayQuery.TraceRayInline(_AccelerationStructure, rayFlags, 1, ray);
    while (rayQuery.Proceed())
    {
    }

    if (rayQuery.CommittedStatus() != COMMITTED_TRIANGLE_HIT)
        return result;

    result.distance = rayQuery.CommittedRayT();
    result.position = origin + direction * result.distance;
    result.instanceId = rayQuery.CommittedInstanceID();
    result.primitiveIndex = rayQuery.CommittedPrimitiveIndex();
    result.receiverNormal = _ReceiverPrimitiveNormals[
        _ReceiverPrimitiveOffsets[result.instanceId] + result.primitiveIndex];
    if (dot(result.receiverNormal, direction) > 0)
        result.receiverNormal = -result.receiverNormal;
    result.valid = 1;
    return result;
}

[numthreads(64, 1, 1)]
void TraceVertices(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    const uint index = dispatchThreadId.x;
    if (index >= _VertexCount)
        return;

    const float3 origin = GetSourceVertexWorld(index);
    _Hits[index] = TraceSourcePoint(origin, GetSourceNormalWorld(index));
}

[numthreads(64, 1, 1)]
void BuildTriangles(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    const uint triangleIndex = dispatchThreadId.x;
    if (triangleIndex >= _TriangleCount)
        return;

    const uint indexOffset = triangleIndex * 3;
    const uint i0 = _SourceIndices[indexOffset];
    const uint i1 = _SourceIndices[indexOffset + 1];
    const uint i2 = _SourceIndices[indexOffset + 2];
    const RayHit h0 = _Hits[i0];
    const RayHit h1 = _Hits[i1];
    const RayHit h2 = _Hits[i2];
    TriangleResult result = (TriangleResult)0;

    if (h0.valid != 0 && h1.valid != 0 && h2.valid != 0
        && h0.instanceId == h1.instanceId && h1.instanceId == h2.instanceId)
    {
        const float3 x0 = GetSourceVertexWorld(i0);
        const float3 x1 = GetSourceVertexWorld(i1);
        const float3 x2 = GetSourceVertexWorld(i2);
        const float3 areaVector = cross(x1 - x0, x2 - x0);
        result.incidentArea = 0.5 * max(0, dot(-normalize(_IncidentDirection), areaVector));
        result.receiverArea = 0.5 * length(cross(h1.position - h0.position, h2.position - h0.position));
        result.intensity = result.incidentArea / max(result.receiverArea, _MinReceiverArea);
        result.valid = result.incidentArea > 0 && result.receiverArea > 0;
        result.receiverBoundary = GetBoundaryReason(h0, h1)
            | GetBoundaryReason(h1, h2)
            | GetBoundaryReason(h2, h0);
        const float3 renderAreaVector = cross(h1.position - h0.position, h2.position - h0.position);
        const float renderAreaLengthSq = dot(renderAreaVector, renderAreaVector);
        const float3 rayDirection = normalize(
            (h0.position + h1.position + h2.position)
            - (x0 + x1 + x2));
        result.renderNormal = renderAreaLengthSq > 1e-16
            ? renderAreaVector * rsqrt(renderAreaLengthSq)
            : -rayDirection;
        if (dot(result.renderNormal, rayDirection) > 0)
            result.renderNormal = -result.renderNormal;
    }

    _TriangleResults[triangleIndex] = result;
}

[numthreads(64, 1, 1)]
void ClearEdgeFlags(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    if (dispatchThreadId.x < _EdgeCount)
        _EdgeFlags[dispatchThreadId.x] = 0;
}

[numthreads(64, 1, 1)]
void MarkBoundaryEdges(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    const uint triangleIndex = dispatchThreadId.x;
    if (triangleIndex >= _TriangleCount || _EnableSubdivision == 0)
        return;

    const uint offset = triangleIndex * 3;
    const RayHit h0 = _Hits[_SourceIndices[offset]];
    const RayHit h1 = _Hits[_SourceIndices[offset + 1]];
    const RayHit h2 = _Hits[_SourceIndices[offset + 2]];
    const uint reason01 = GetBoundaryReason(h0, h1);
    const uint reason12 = GetBoundaryReason(h1, h2);
    const uint reason20 = GetBoundaryReason(h2, h0);
    if (reason01 != 0)
        InterlockedOr(_EdgeFlags[_TriangleEdges[offset]], reason01);
    if (reason12 != 0)
        InterlockedOr(_EdgeFlags[_TriangleEdges[offset + 1]], reason12);
    if (reason20 != 0)
        InterlockedOr(_EdgeFlags[_TriangleEdges[offset + 2]], reason20);
}

[numthreads(64, 1, 1)]
void TraceEdgeMidpoints(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    const uint edgeIndex = dispatchThreadId.x;
    if (edgeIndex >= _EdgeCount || _EdgeFlags[edgeIndex] == 0)
        return;

    const SourceEdge edge = _SourceEdges[edgeIndex];
    const float3 position = 0.5 * (
        GetSourceVertexWorld(edge.vertex0) + GetSourceVertexWorld(edge.vertex1));
    const float3 normal = normalize(
        GetSourceNormalWorld(edge.vertex0) + GetSourceNormalWorld(edge.vertex1));
    _EdgeHits[edgeIndex] = TraceSourcePoint(position, normal);
}

RayHit GetProjectedHit(uint vertexReference)
{
    if (vertexReference < _VertexCount)
        return _Hits[vertexReference];
    return _EdgeHits[vertexReference - _VertexCount];
}

float3 GetProjectedSourcePosition(uint vertexReference)
{
    if (vertexReference < _VertexCount)
        return GetSourceVertexWorld(vertexReference);
    const SourceEdge edge = _SourceEdges[vertexReference - _VertexCount];
    return 0.5 * (GetSourceVertexWorld(edge.vertex0) + GetSourceVertexWorld(edge.vertex1));
}

void EmitProjectedTriangle(uint r0, uint r1, uint r2)
{
    const RayHit h0 = GetProjectedHit(r0);
    const RayHit h1 = GetProjectedHit(r1);
    const RayHit h2 = GetProjectedHit(r2);
    if (h0.valid == 0 || h1.valid == 0 || h2.valid == 0
        || h0.instanceId != h1.instanceId || h1.instanceId != h2.instanceId)
        return;

    const float3 x0 = GetProjectedSourcePosition(r0);
    const float3 x1 = GetProjectedSourcePosition(r1);
    const float3 x2 = GetProjectedSourcePosition(r2);
    const float incidentArea = 0.5 * max(
        0, dot(-normalize(_IncidentDirection), cross(x1 - x0, x2 - x0)));
    const float receiverArea = 0.5 * length(cross(
        h1.position - h0.position, h2.position - h0.position));
    if (incidentArea <= 0 || receiverArea <= 0)
        return;

    uint outputIndex;
    InterlockedAdd(_OutputCounter[0], 1, outputIndex);
    if (outputIndex >= _MaxOutputTriangles)
        return;

    const uint outputOffset = outputIndex * 3;
    _ProjectedIndices[outputOffset] = r0;
    _ProjectedIndices[outputOffset + 1] = r1;
    _ProjectedIndices[outputOffset + 2] = r2;
    ProjectedResult result = (ProjectedResult)0;
    result.intensity = incidentArea / max(receiverArea, _MinReceiverArea);
    result.receiverBoundary = GetBoundaryReason(h0, h1)
        | GetBoundaryReason(h1, h2)
        | GetBoundaryReason(h2, h0);
    result.valid = 1;
    _ProjectedResults[outputIndex] = result;
}

[numthreads(64, 1, 1)]
void BuildProjectedTriangles(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    const uint triangleIndex = dispatchThreadId.x;
    if (triangleIndex >= _TriangleCount)
        return;

    const uint offset = triangleIndex * 3;
    const uint v0 = _SourceIndices[offset];
    const uint v1 = _SourceIndices[offset + 1];
    const uint v2 = _SourceIndices[offset + 2];
    const uint e01 = _TriangleEdges[offset];
    const uint e12 = _TriangleEdges[offset + 1];
    const uint e20 = _TriangleEdges[offset + 2];
    const uint m01 = _VertexCount + e01;
    const uint m12 = _VertexCount + e12;
    const uint m20 = _VertexCount + e20;
    const uint mask = (_EdgeFlags[e01] != 0 ? 1 : 0)
        | (_EdgeFlags[e12] != 0 ? 2 : 0)
        | (_EdgeFlags[e20] != 0 ? 4 : 0);

    if (mask == 0)
        EmitProjectedTriangle(v0, v1, v2);
    else if (mask == 1)
    {
        EmitProjectedTriangle(v0, m01, v2);
        EmitProjectedTriangle(m01, v1, v2);
    }
    else if (mask == 2)
    {
        EmitProjectedTriangle(v1, m12, v0);
        EmitProjectedTriangle(m12, v2, v0);
    }
    else if (mask == 4)
    {
        EmitProjectedTriangle(v2, m20, v1);
        EmitProjectedTriangle(m20, v0, v1);
    }
    else if (mask == 3)
    {
        EmitProjectedTriangle(m01, v1, m12);
        EmitProjectedTriangle(v0, m01, m12);
        EmitProjectedTriangle(v0, m12, v2);
    }
    else if (mask == 6)
    {
        EmitProjectedTriangle(m12, v2, m20);
        EmitProjectedTriangle(v1, m12, m20);
        EmitProjectedTriangle(v1, m20, v0);
    }
    else if (mask == 5)
    {
        EmitProjectedTriangle(m20, v0, m01);
        EmitProjectedTriangle(v2, m20, m01);
        EmitProjectedTriangle(v2, m01, v1);
    }
    else
    {
        EmitProjectedTriangle(v0, m01, m20);
        EmitProjectedTriangle(m01, v1, m12);
        EmitProjectedTriangle(m20, m12, v2);
        EmitProjectedTriangle(m01, m12, m20);
    }
}

[numthreads(1, 1, 1)]
void BuildOutputArgs(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    _OutputArgs[0] = min(_OutputCounter[0], _MaxOutputTriangles) * 3;
    _OutputArgs[1] = 1;
    _OutputArgs[2] = 0;
    _OutputArgs[3] = 0;
}
